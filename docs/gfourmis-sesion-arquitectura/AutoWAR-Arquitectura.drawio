        <mxCell id="tb1" value="A. redirige con JWT (entitlements + cuentas + vigencia)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;fontSize=10;labelBackgroundColor=#F5F5F5;dashed=1;" edge="1" parent="1" source="t_hub" target="t_cognito">
